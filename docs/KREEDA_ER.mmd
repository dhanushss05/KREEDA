erDiagram
    MEMBER {
        int member_id PK
        string reg_no
        string full_name
        string member_type
        string department
        string contact_no
        string email
        boolean is_active
    }
    STAFF {
        int staff_id PK
        string emp_code
        string full_name
        string designation
        string contact_no
    }
    APP_USER {
        int user_id PK
        string username
        string password_hash
        string role
        int member_id FK
        int staff_id FK
        timestamp last_login
    }
    COURT {
        int court_id PK
        string name
        string sport
        string location
        int capacity
        time open_time
        time close_time
        boolean is_active
        int max_daily_bookings
        int max_peak_per_week
        time peak_start
        time peak_end
    }
    SLOT {
        int slot_id PK
        int court_id FK
        date slot_date
        time start_time
        time end_time
        string status
    }
    BOOKING {
        int booking_id PK
        int slot_id FK
        int member_id FK
        timestamp booked_at
        string status
        timestamp cancelled_at
        string cancel_reason
    }
    WAITING_LIST {
        int wait_id PK
        int slot_id FK
        int member_id FK
        int position
        timestamp joined_at
        string status
    }
    ATTENDANCE {
        int attendance_id PK
        int booking_id FK
        int marked_by FK
        timestamp check_in
        timestamp check_out
        boolean is_no_show
    }
    EVENT {
        int event_id PK
        int created_by FK
        string name
        string sport
        date start_date
        date end_date
        int capacity
        text description
    }
    EVENT_REGISTRATION {
        int registration_id PK
        int event_id FK
        int member_id FK
        timestamp registered_on
        string status
    }
    COURT_BLOCK {
        int block_id PK
        int event_id FK
        int court_id FK
        date block_date
        time start_time
        time end_time
        string reason
    }
    GAME_POST {
        int post_id PK
        int member_id FK
        string sport
        text post_text
        string preferred_time
        boolean is_open
        timestamp posted_at
    }
    COMPLAINT {
        int complaint_id PK
        int member_id FK
        int court_id FK
        int equipment_id FK
        text complaint_text
        string status
        timestamp reported_on
        int duplicate_of FK
    }
    LOCKER_KEY {
        int key_id PK
        string key_code
        string key_section
        string status
    }
    KEY_ISSUE {
        int key_issue_id PK
        int key_id FK
        int member_id FK
        int issued_by FK
        timestamp in_time
        timestamp out_time
    }
    EQUIPMENT {
        int equipment_id PK
        string equip_code
        string name
        string category
        int total_qty
        int available_qty
    }
    EQUIPMENT_ISSUE {
        int eq_issue_id PK
        int equipment_id FK
        int member_id FK
        int issued_by FK
        int qty_issued
        timestamp issue_time
        timestamp due_time
        timestamp return_time
        decimal fine_amount
    }

